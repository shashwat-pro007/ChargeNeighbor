# ---------------------------------------------------------------------------
# ChargeNeighbor API — environment configuration
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Where the SQLite database, the signing secret and uploads live.
# Relative paths are resolved from the server directory.
DATA_DIR=./data

# ---------------------------------------------------------------- security --
# A long random string used to sign session cookies.
# Leave empty in development and one is generated into DATA_DIR/.jwt-secret.
# REQUIRED in production.
JWT_SECRET=
SESSION_DAYS=30
COOKIE_SECURE=false

# Extra browser origins allowed to call the API (comma separated).
# The dev proxy makes the browser same-origin, so this is normally empty.
ALLOWED_ORIGINS=

# ------------------------------------------------------------------ market --
# Platform service fee applied to every booking, in percent.
PLATFORM_FEE_PERCENT=8
CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
# A slot can never start less than this many minutes from now.
MIN_LEAD_MINUTES=30
# Availability is generated in these increments.
SLOT_STEP_MINUTES=30

# -------------------------------------------------------------- payments ----
# "offline" = no online payment provider is connected yet. Bookings are
# confirmed and the money is collected at the session; the UI says so plainly.
# Connect a provider in server/src/services/payments.js to switch to "online".
PAYMENTS_MODE=offline

# --------------------------------------------------------------- OTP auth ---
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=45

# ------------------------------------------------------- TEST-ONLY LOGIN -----
# The product has no seeded demo users. During testing you can sign in with a
# real-looking test number using one fixed OTP instead of a delivered code.
# Turn TEST_LOGIN_ENABLED off (and restart) to require real OTP delivery again.
TEST_LOGIN_ENABLED=true
TEST_OTP=123456
# Comma separated full numbers, and/or prefixes matched from the start.
TEST_PHONE_NUMBERS=+919999000001,+919999000002
TEST_PHONE_PREFIXES=+919999

# ------------------------------------------------------------- operations ---
# The first account that signs in with one of these numbers gets the admin role.
ADMIN_PHONES=

# ---------------------------------------------------------------- uploads ---
MAX_UPLOAD_MB=5
